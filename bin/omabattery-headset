#!/usr/bin/env bash
# USB-dongle headsets through HeadsetControl (https://github.com/Sapd/HeadsetControl).
# Prints the raw `headsetcontrol -o json` output, parsed by Model.parseHeadset.
# Prints {"devices":[]} when headsetcontrol is missing, hangs or prints
# nothing, so Service.qml never has to special-case a failure.
#
# Talking to the dongle needs the udev rules the headsetcontrol package
# installs; they apply after replugging the dongle (or a reboot).
set -u

empty='{"devices":[]}'

if ! command -v headsetcontrol >/dev/null 2>&1; then
  echo "$empty"
  exit 0
fi

# headsetcontrol may exit non-zero and still print valid JSON (no device).
out=$(timeout 5 headsetcontrol -o json 2>/dev/null) || true
if [[ -z "$out" ]]; then
  echo "$empty"
else
  printf '%s\n' "$out"
fi
